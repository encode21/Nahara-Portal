NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role / secret — server-only (cron BMKG gempa → notifikasi/push).
# Jangan expose ke browser. Di dashboard Supabase baru namanya "secret".
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# SUPABASE_SECRET_KEY=your_supabase_secret_key

# Cron auth for /api/cron/bmkg-gempa (Vercel Cron + manual curl)
CRON_SECRET=generate_a_long_random_string

# Web Push (portal notifikasi + Agustusan doorprize)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nahara.id

# Canonical public SEO (landing) — sitemap / OG / Google
NEXT_PUBLIC_SITE_URL=https://nahara.id
NEXT_PUBLIC_LANDING_URL=https://nahara.id
NEXT_PUBLIC_PORTAL_URL=https://portal.nahara.id

# Tiga host (satu repo)
NEXT_PUBLIC_LANDING_HOST=nahara.id
NEXT_PUBLIC_PORTAL_HOST=portal.nahara.id
NEXT_PUBLIC_OPS_HOST=ops.nahara.id

# Lokal: paksa surface (landing|portal|ops)
# NEXT_PUBLIC_APP_SURFACE=landing
