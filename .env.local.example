NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Canonical URL (Open Graph / sitemap). Prefer portal warga:
NEXT_PUBLIC_SITE_URL=https://portal.nahara.id

# Dual-host (satu repo Next.js)
NEXT_PUBLIC_PORTAL_HOST=portal.nahara.id
NEXT_PUBLIC_OPS_HOST=nahara.id

# Lokal: paksa surface ops saat test di localhost (portal|ops)
# NEXT_PUBLIC_APP_SURFACE=ops

# Setelah deploy: jalankan supabase/migrations termasuk harden portal security
# untuk bucket Storage "nahara-uploads" dan RLS admin role
